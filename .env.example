# ---------------------------------------------------------------------------
# PEDRO_ARTE_YOUTUBE_LIVING_BOOK_ENGINE — variáveis de ambiente
# ---------------------------------------------------------------------------
# Copie para `.env` e preencha apenas o que for utilizar.
#
#   cp .env.example .env
#
# ATENÇÃO: o arquivo `.env` está no `.gitignore` e NUNCA deve ser versionado.
# Nenhuma variável abaixo é necessária para executar o motor no modo padrão
# (`execute_generation: false`), que apenas gera prompts e manifestos.
# ---------------------------------------------------------------------------

# --- Ambiente -------------------------------------------------------------
LIVING_VIDEO_ENV=development
LIVING_VIDEO_LOG_LEVEL=INFO
LIVING_VIDEO_LOG_FORMAT=console          # console | json

# --- Diretórios (respeitam a allowlist de caminhos do motor) --------------
LIVING_VIDEO_INPUT_DIR=./input
LIVING_VIDEO_OUTPUT_DIR=./outputs
LIVING_VIDEO_CACHE_DIR=./.livingvideo_cache

# --- Execução real de mídia ----------------------------------------------
# Só tem efeito quando o projeto também define `providers.execute_generation: true`.
LIVING_VIDEO_EXECUTE_GENERATION=false
LIVING_VIDEO_MAX_BUDGET_USD=0

# --- Credenciais de provedores (opcionais) -------------------------------
# Deixe em branco para operar 100% offline com os adaptadores determinísticos.
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- API HTTP opcional ----------------------------------------------------
LIVING_VIDEO_API_HOST=127.0.0.1
LIVING_VIDEO_API_PORT=8000

# --- Servidor MCP ---------------------------------------------------------
LIVING_VIDEO_MCP_ALLOWED_ROOTS=./input,./outputs,./examples
LIVING_VIDEO_MCP_MAX_PAYLOAD_BYTES=1048576
